{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_PACK_SANDBOX": "true",
        "EXPO_PUBLIC_ENABLE_RELEASE_PACK_QA": "true",
        "EXPO_PUBLIC_QA_BUILD": "true",
        "EXPO_PUBLIC_BUILD_PROFILE": "preview",
        "EXPO_PUBLIC_GLOBAL_MANIFEST_URL": "https://pub-f990153eeeb9460ab963038904f3ac96.r2.dev/content-manifest.json"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      }
    },
    "preview-criador": {
      "extends": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_PACK_SANDBOX": "true",
        "EXPO_PUBLIC_ENABLE_RELEASE_PACK_QA": "true",
        "EXPO_PUBLIC_QA_BUILD": "true",
        "EXPO_PUBLIC_BUILD_PROFILE": "preview-criador",
        "EXPO_PUBLIC_ENABLE_CREATOR_QA_MODE": "true",
        "EXPO_PUBLIC_GLOBAL_MANIFEST_URL": "https://pub-f990153eeeb9460ab963038904f3ac96.r2.dev/content-manifest.json"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_GLOBAL_MANIFEST_URL": "https://pub-f990153eeeb9460ab963038904f3ac96.r2.dev/content-manifest.json"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium"
      }
    },
    "screenshot": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      }
    }
  }
}
