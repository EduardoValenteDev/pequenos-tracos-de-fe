{
  "name": "pequenos-tracos-de-fe",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:env": "node scripts/check-env.js",
    "start:dev": "node scripts/check-env.js && expo start --dev-client --clear --lan",
    "doctor": "npx expo-doctor",
    "qa": "npx expo install --check",
    "smoke": "node scripts/smoke.js",
    "bundle:check": "expo export:embed --platform android --entry-file index.js --dev false --minify false --bundle-output .expo/bundle-check.jsbundle",
    "assets:inventory": "node scripts/assets-pipeline/inventory.js",
    "assets:measure": "node scripts/assets-pipeline/measure-size.js",
    "assets:guard": "node scripts/assets-pipeline/check-untracked-guard.js",
    "assets:validate-manifest": "node scripts/assets-pipeline/validate-pack-manifest.js",
    "assets:budget": "node scripts/assets-pipeline/budget-report.js",
    "assets:growth": "node scripts/assets-pipeline/growth-projection.js",
    "assets:traceability": "node scripts/assets-pipeline/traceability.js",
    "assets:check-ratio": "node scripts/assets-pipeline/check-ratio.js",
    "assets:optimize-scene": "node scripts/assets-pipeline/optimize-scene.js",
    "audio:audit": "node scripts/audio-audit.js",
    "scene:images:audit": "node scripts/sceneIllustrationsAudit.js",
    "scene:images:audit:strict": "node scripts/sceneIllustrationsAudit.js --strict",
    "scene:images:audit:story": "node scripts/sceneIllustrationsAudit.js --story",
    "scene:images:audit:story:strict": "node scripts/sceneIllustrationsAudit.js --strict --story",
    "audio:audit:strict": "node scripts/audio-audit.js --strict",
    "audio:audit:self-test": "node scripts/audio-audit-self-test.js",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:production:ios": "eas build --platform ios --profile production",
    "build:production:android": "eas build --platform android --profile production",
    "build:preview": "eas build --platform all --profile preview",
    "build:production": "eas build --platform all --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/fredoka-one": "^0.2.3",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/stack": "^7.9.2",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.4.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "private": true,
  "devDependencies": {
    "sharp": "0.35.2"
  }
}
